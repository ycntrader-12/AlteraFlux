# --- Environnement AlteraFlux ---
ENVIRONMENT=development
PROJECT_NAME="AlteraFlux Universal Converter"
DEBUG=True

# --- Base de Données (PostgreSQL / Supabase) ---
POSTGRES_USER=alteraflux
POSTGRES_PASSWORD=alteraflux_secret
POSTGRES_DB=alteraflux_db
DATABASE_URL=postgresql+asyncpg://alteraflux:alteraflux_secret@localhost:5432/alteraflux_db

# --- Message Broker & Cache (Redis) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Stockage Objet (MinIO / S3 / Supabase Storage) ---
# En local avec MinIO :
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=altera_admin
S3_SECRET_KEY=altera_secret_key
STORAGE_BUCKET_NAME=alteraflux-storage
S3_REGION_NAME=us-east-1

# --- Sécurité & Limites ---
JWT_SECRET_KEY=super_secret_jwt_alteraflux_token_key_change_in_prod
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000
MAX_UPLOAD_SIZE_MB=2048
RATE_LIMIT_PER_MINUTE=60

# --- IA / Agentic Code Translation ---
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Frontend Next.js ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_STORAGE_URL=http://localhost:9000
